# Model Configuration Environment Variables
# Copy to models.env and customize

# ===========================================
# qwen2.5-coder:7b Configuration
# ===========================================
# Ollama GPU layers to offload (0 = CPU only, 35+ = GPU)
# RTX 5060 Ti 8GB: recommend 35-40 for 7B q4 model
OLLAMA_QWEN_GPU_LAYERS=35

# Number of parallel requests (1 = sequential, prevents OOM)
OLLAMA_QWEN_NUM_PARALLEL=1

# Enable flash attention for faster inference
OLLAMA_QWEN_FLASH_ATTENTION=true

# KV cache quantization (q4_0 = 4-bit, saves VRAM)
OLLAMA_QWEN_KV_CACHE_TYPE=q4_0

# Host port mapping (default 11434)
OLLAMA_QWEN_PORT=11434

# Model pull settings
OLLAMA_QWEN_MODEL=qwen2.5-coder:7b
OLLAMA_QWEN_QUANTIZATION=q4_k_m

# ===========================================
# deepseek-r1:8b Configuration
# ===========================================
OLLAMA_DEEPSEEK_GPU_LAYERS=35
OLLAMA_DEEPSEEK_NUM_PARALLEL=1
OLLAMA_DEEPSEEK_FLASH_ATTENTION=true
OLLAMA_DEEPSEEK_KV_CACHE_TYPE=q4_0
OLLAMA_DEEPSEEK_PORT=11435
OLLAMA_DEEPSEEK_MODEL=deepseek-r1:8b
OLLAMA_DEEPSEEK_QUANTIZATION=q4_k_m

# ===========================================
# Shared Model Settings
# ===========================================
# Context window size (adjust based on VRAM)
# 4096 = default, 8192 = larger context (needs more VRAM)
OLLAMA_CONTEXT_SIZE=4096

# Temperature for generation (0.0 = deterministic, 1.0 = creative)
OLLAMA_TEMPERATURE=0.7

# Top-p sampling
OLLAMA_TOP_P=0.9

# ===========================================
# Advanced GPU Settings (RTX 5060 Ti 8GB)
# ===========================================
# CUDA_VISIBLE_DEVICES=0  # Use first GPU only
# OLLAMA_NUM_GPU=1        # Number of GPUs to use

# Memory management
# OLLAMA_MAX_VRAM=7GB     # Reserve 1GB for system/OS
# OLLAMA_KEEP_ALIVE=5m    # Keep model loaded for 5 minutes after last request