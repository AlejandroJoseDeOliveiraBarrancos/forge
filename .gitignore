# Forge Git Ignore
# Root level gitignore for forge repository

# Deployment Docker local overrides and secrets
deployment/docker/docker-compose.override.yml
deployment/docker/models/models.env
deployment/docker/dependencies/dependencies.env

# Data volumes and persistence (created at runtime)
deployment/docker/data/
deployment/docker/volumes/
**/*.db
**/*.sqlite
**/*.sqlite3

# Ollama model cache (large, pulled at runtime)
**/.ollama/
**/models/*.bin
**/models/*.gguf
**/models/*.safetensors

# Logs
*.log
logs/
**/*.log

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Backup files
*.bak
*.backup
*~

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
dist/
build/
*.egg-info/